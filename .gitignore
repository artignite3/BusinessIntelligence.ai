# ==============================================================================
# BusinessIntelligence.ai — Enterprise .gitignore
# Prevents data leakage, environment secrets, build artifacts, & dependencies
# ==============================================================================

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / Optimized Python Binaries
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Environment Variables & Secrets (Data Protection & Privacy)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
secrets/
credentials.json
token.json

# Node.js & Next.js 14 Build Artifacts
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & Sensitive Local Stores
*.sqlite3
*.db
data/private/
feedback_store.json

# Operating System & IDE Configs
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Log Files & Test Reports
*.log
.coverage
htmlcov/
.pytest_cache/

# Submission Artifacts (local only)
submission_deliverables/
generate_submission_artifacts.py
